+void dav_scheduler::done_adding_supervised_warps() {
+  gto_scheduler::done_adding_supervised_warps();
+  const auto *config = m_shader->get_config();
+  const char *policy = config->gpgpu_scheduler_string;
+  unsigned alpha = !strcmp(policy, "dav") ? 1000 :
+      !strcmp(policy, "lav") ? 0 : config->gpgpu_ld_alpha;
+  m_locality_weight = 1000 - alpha;
+  m_prediction_mode = config->gpgpu_locality_predictor;
+  m_stall_aware = !strcmp(policy, "stall");
+  // LAV-limit is enabled by environment variable so no config option is needed.
+  const char *limit = getenv("LAV_WARP_LIMIT");
+  m_warp_limit = (limit && !m_stall_aware) ? atoi(limit) : 0;
+  const char *lls_mode = getenv("LLS_MODE");
+  m_lls_mode = (lls_mode && !m_stall_aware) ? atoi(lls_mode) : 0;
+  const char *lls_k = getenv("LLS_K");
+  m_lls_k = lls_k ? atoi(lls_k) : 8;
+  if (!m_lls_k) m_lls_k = 1;
+  const char *lls_window = getenv("LLS_WINDOW");
+  m_ctl_window = lls_window ? atoi(lls_window) : 2000;
+  if (!m_ctl_window) m_ctl_window = 1;
+  const char *lls_hi = getenv("LLS_HI");
+  m_ctl_hi = lls_hi ? atoi(lls_hi) : 200;
+  const char *lls_lo = getenv("LLS_LO");
+  m_ctl_lo = lls_lo ? atoi(lls_lo) : 60;
+  m_ctl_n = m_supervised_warps.size();
+  m_ctl_calls = 0;
+  // DAWS budget: this scheduler's share of the L1 lines, times LLS_EFF %.
+  const char *l1_lines = getenv("LLS_L1_LINES");
+  const char *eff = getenv("LLS_EFF");
+  const char *reuse_pct = getenv("LLS_REUSE_PCT");
+  unsigned lines = l1_lines ? atoi(l1_lines) : 2048;  // 256 KB / 128 B
+  unsigned eff_pct = eff ? atoi(eff) : 100;
+  unsigned nsched = config->gpgpu_num_sched_per_core
+                        ? config->gpgpu_num_sched_per_core : 1;
+  // Eff cache size = kAssocFactor (LLS_EFF %) x total lines (DAWS Eq. 1),
+  // split evenly over the SM's schedulers.
+  m_daws_budget = 1ULL * lines * eff_pct / 100 / nsched;
+  m_daws_reuse_pct = reuse_pct ? atoi(reuse_pct) : 25;
+  const char *warp_reuse = getenv("LLS_WARP_REUSE");
+  m_daws_warp_reuse_pct = warp_reuse ? atoi(warp_reuse) : 70;
+  static bool reported = false;
+  if (!reported) {
+    printf("LAV_WARP_LIMIT = %u\n", m_warp_limit);
+    printf("LLS_MODE = %u LLS_K = %u\n", m_lls_mode, m_lls_k);
+    printf("LLS_WINDOW = %u LLS_HI = %u LLS_LO = %u (1/10000)\n",
+           m_ctl_window, m_ctl_hi, m_ctl_lo);
+    printf("DAWS L1_LINES = %u EFF = %u%% sched = %u budget = %llu lines "
+           "REUSE_PCT = %u\n", lines, eff_pct, nsched,
+           m_daws_budget, m_daws_reuse_pct);
+    printf("DAWS2 LLS_WARP_REUSE = %u\n", m_daws_warp_reuse_pct);
+    reported = true;
+  }
+  assert(config->warp_size <= MAX_WARP_SIZE);
+  for (unsigned active = 0; active <= config->warp_size; ++active)
+    m_weighted_divergence[active] = alpha * (1024ULL * active / config->warp_size);
+  m_candidates.reserve(m_supervised_warps.size());
+  m_next_cycle_prioritized_warps.reserve(m_supervised_warps.size());
+}
