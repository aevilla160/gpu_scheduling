+
+  static divergence_stats stats;
+
+  const bool check_divergence =
+      !strcmp(m_shader->get_config()->gpgpu_scheduler_string, "dav");
+
+  unsigned runnable_count = 0;
+  unsigned min_active = MAX_WARP_SIZE;
+  unsigned max_active = 0;
+  m_candidates.clear();
