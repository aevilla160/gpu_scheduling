+void dav_scheduler::order_warps() {
+    struct divergence_stats {
+    unsigned long long calls = 0;
+    unsigned long long multi_candidate = 0;
+    unsigned long long different_active = 0;
+    unsigned long long active_hist[MAX_WARP_SIZE + 1] = {};
+
+    ~divergence_stats() {
+      printf("\nDIVCHECK scheduler_calls=%llu multi_candidate=%llu "
+             "different_active=%llu\n",
+             calls, multi_candidate, different_active);
